# Dockerfile for zero-cache with the Go IVM sidecar bundled.
# The Go binary is pulled from the published go-ivm image (built by
# the go-ivm- repo's GitHub Actions workflow on every push to main).
# Override GO_IVM_IMAGE to pin a specific tag (default: latest).

ARG GO_IVM_IMAGE=ghcr.io/kartikparsoya-eng/go-ivm:latest

# Stage 1: grab the prebuilt Go IVM binary
FROM ${GO_IVM_IMAGE} AS go-ivm

# Stage 2: zero-cache runtime
FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    wget ca-certificates python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files first for better layer caching
COPY package.json package-lock.json ./
COPY packages/zero-cache/package.json packages/zero-cache/
COPY packages/zero-protocol/package.json packages/zero-protocol/
COPY packages/zero-schema/package.json packages/zero-schema/
COPY packages/shared/package.json packages/shared/
COPY packages/zql/package.json packages/zql/

# Stub package.json for workspace packages that might be referenced
RUN find packages -maxdepth 1 -mindepth 1 -type d | while read dir; do \
    if [ ! -f "$dir/package.json" ]; then \
      echo '{"name":"'$(basename $dir)'","version":"0.0.0"}' > "$dir/package.json"; \
    fi; done

# Install all deps (including native binaries like esbuild)
RUN npm install --prefer-offline 2>&1 | tail -5

# OpenTelemetry auto-instrumentation. Packages are installed at the
# workspace root so they're resolvable from zero-cache at runtime.
# Always installed; SDK is wired via NODE_OPTIONS below but no-ops
# at runtime when OTEL_EXPORTER_OTLP_ENDPOINT is unset (no perf cost
# for operators who don't enable tracing).
RUN npm install --no-save \
    @opentelemetry/auto-instrumentations-node \
    @opentelemetry/sdk-node \
    2>&1 | tail -5

# Now copy all source
COPY . .

# Bundle the Go IVM binary into the image (replaces the bind-mount
# pattern the earlier revision used).
COPY --from=go-ivm /usr/local/bin/go-ivm-sidecar /opt/go-ivm/go-ivm-sidecar

# Build-time mode selector:
#   SHADOW_MODE=false (default) → Go-primary image (Go serves clients)
#   SHADOW_MODE=true            → Shadow image (TS source of truth,
#                                  Go runs in parallel for drift audit)
# CI publishes both variants to different tags off the same Dockerfile.
ARG SHADOW_MODE=false

# All ENV defaults are overridable at `docker run -e` / compose env-block
# time. See go-ivm/REVIEW-final.md for the recommended rollout sequence
# (shadow on 1 prod node → ~1 week observation → flip to primary).
ENV NODE_ENV=production
ENV ZERO_GO_SIDECAR_BINARY_PATH=/opt/go-ivm/go-ivm-sidecar
ENV ZERO_GO_SIDECAR_ENABLED=true
ENV ZERO_GO_SIDECAR_EXTERNALLY_MANAGED=true
ENV ZERO_GO_SIDECAR_SOCKET_PATH=/tmp/go-ivm-shared.sock
ENV ZERO_GO_SIDECAR_SHADOW_MODE=${SHADOW_MODE}
# workers=1 keeps cg state colocated in the single shared sidecar
# (per feedback_shared_sidecar_tuning — bumping workers fragments
# cgs across sidecars under per-worker mode; in shared mode it just
# adds V8 GC overhead with no concurrency win).
ENV ZERO_NUM_SYNC_WORKERS=1
# Pre-wire OTel auto-instrumentation. The /register hook initializes
# the SDK at startup; OTLP exporter no-ops when
# OTEL_EXPORTER_OTLP_ENDPOINT is unset, so there's no cost for
# operators who don't enable tracing. Set
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318 + OTEL_SERVICE_NAME
# at deploy time to turn it on.
ENV NODE_OPTIONS='--require @opentelemetry/auto-instrumentations-node/register'

EXPOSE 4848

WORKDIR /app/packages/zero-cache

# Custom entrypoint spawns the shared sidecar before zero-cache,
# waits for the socket, then execs the normal zero-cache main.
COPY packages/zero-cache/docker-entrypoint-go-primary.sh /usr/local/bin/zero-cache-entrypoint.sh
RUN chmod +x /usr/local/bin/zero-cache-entrypoint.sh

CMD ["/usr/local/bin/zero-cache-entrypoint.sh"]
