# Dockerfile for zero-cache with the Go IVM sidecar bundled.
# The Go binary is pulled from the published go-ivm image (built by
# the go-ivm- repo's GitHub Actions workflow on every push to main).
# Override GO_IVM_IMAGE to pin a specific tag (default: latest).

ARG GO_IVM_IMAGE=ghcr.io/kartikparsoya-eng/go-ivm:latest

# Stage 1: grab the prebuilt Go IVM binary
FROM ${GO_IVM_IMAGE} AS go-ivm

# Stage 2: build litestream from rocicorp's fork (replicator role needs it
# for continuous SQLite → S3/GCS backup so future syncers can restore
# the replica without a multi-GB resync from upstream PG).
FROM golang:1.23 AS litestream-builder
WORKDIR /src
RUN git clone --depth 1 --branch zero@v0.0.9 \
    https://github.com/rocicorp/litestream.git /src/litestream
WORKDIR /src/litestream
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg \
    go build \
      -ldflags "-s -w -extldflags '-static'" \
      -tags osusergo,netgo,sqlite_omit_load_extension \
      -o /usr/local/bin/litestream \
      ./cmd/litestream

# Stage 3: pull official litestream v5 binary (for backward compat with
# older replica backups; rocicorp's pattern keeps both around).
FROM litestream/litestream:0.5.11 AS litestream-v5

# Stage 4: zero-cache runtime
FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    wget ca-certificates python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files first for better layer caching
COPY package.json package-lock.json ./
COPY packages/zero-cache/package.json packages/zero-cache/
COPY packages/zero-protocol/package.json packages/zero-protocol/
COPY packages/zero-schema/package.json packages/zero-schema/
COPY packages/shared/package.json packages/shared/
COPY packages/zql/package.json packages/zql/

# Stub package.json for workspace packages that might be referenced
RUN find packages -maxdepth 1 -mindepth 1 -type d | while read dir; do \
    if [ ! -f "$dir/package.json" ]; then \
      echo '{"name":"'$(basename $dir)'","version":"0.0.0"}' > "$dir/package.json"; \
    fi; done

# Install all deps (including native binaries like esbuild)
RUN npm install --prefer-offline 2>&1 | tail -5

# OpenTelemetry auto-instrumentation. Packages are installed at the
# workspace root so they're resolvable from zero-cache at runtime.
# Always installed; SDK is wired via NODE_OPTIONS below but no-ops
# at runtime when OTEL_EXPORTER_OTLP_ENDPOINT is unset (no perf cost
# for operators who don't enable tracing).
RUN npm install --no-save \
    @opentelemetry/auto-instrumentations-node \
    @opentelemetry/sdk-node \
    2>&1 | tail -5

# Now copy all source
COPY . .

# Bundle the Go IVM binary into the image (replaces the bind-mount
# pattern the earlier revision used).
COPY --from=go-ivm /usr/local/bin/go-ivm-sidecar /opt/go-ivm/go-ivm-sidecar

# Bundle litestream for the replicator role's SQLite backup pipeline.
# Both v0 (rocicorp fork) and v5 (official) are kept; zero-cache picks
# the right one based on the backup URL's storage version.
COPY --from=litestream-builder /usr/local/bin/litestream /usr/local/bin/litestream
COPY --from=litestream-v5      /usr/local/bin/litestream /usr/local/bin/litestream-v5
# Litestream config lives in our source — copy it to the canonical path
# zero-cache reads from via ZERO_LITESTREAM_CONFIG_PATH.
RUN cp /app/packages/zero-cache/src/services/litestream/config.yml /etc/litestream.yml

# Build-time mode selector:
#   SHADOW_MODE=false (default) → Go-primary image (Go serves clients)
#   SHADOW_MODE=true            → Shadow image (TS source of truth,
#                                  Go runs in parallel for drift audit)
# CI publishes both variants to different tags off the same Dockerfile.
ARG SHADOW_MODE=false

# Leaf-source selector for the Go sidecar (see
# go-ivm/DESIGN-tablesource-port.md). Default is "memory" so the existing
# primary/shadow images keep their current loadRows-populated
# MemorySource behavior unchanged. "table" switches to the read-from-
# replica TableSource — only the tablesrc image variant sets this.
# When SOURCE_MODE=table, the deployer must also set
# GO_IVM_REPLICA_DB_PATH at runtime (no sensible default — the path is
# environment-specific).
ARG SOURCE_MODE=memory

# Go-primary serving selectors (snapshotter-in-go port). Both default
# false so the existing memory primary/shadow images are unchanged; only
# the table-mode Go-primary variant sets them true:
#   GO_PRIMARY_TRIGGER=true → Go derives its OWN diff via advanceToHead
#                             (self-consistent V_go), not push-applies TS's.
#   LEAN_PRIMARY=true       → TS walks INTERNAL/control-plane tables only;
#                             Go owns all user-table changes.
# Shadow variants keep both false (TS stays source of truth).
ARG GO_PRIMARY_TRIGGER=false
ARG LEAN_PRIMARY=false

# Frame-coordinated advance (snapshotter-in-go P2). ONE arg arms both sides:
#   sidecar: GO_IVM_ADVANCE_DRIVE=true (implies GO_IVM_ADVANCE_TO_HEAD — the
#            sidecar builds per-CG Snapshotters and binds tablesource leaves
#            to the pinned frame; without it, advanceToHead RPCs fail and a
#            trigger-baked image can never serve Go-primary).
#   mono:    ZERO_GO_SIDECAR_ADVANCE_DRIVE=true — shadow-only gate: in shadow
#            mode the Go advance is sourced via advanceToHead and compared to
#            TS (validated 2026-06-10: same-seed soak, push-mode drift=140
#            FAIL vs drive-mode drift=0 PASS — push-applying TS's diff to an
#            independently-pinned snapshot frame-skews during mutation
#            bursts). In primary mode (shadowMode=false) it is a no-op; the
#            trigger path is selected by GO_PRIMARY_TRIGGER instead.
# true for tablesrc (Go-primary needs the sidecar armed) and shadow-tablesrc
# (pre-prod soak validates the same frame-coordinated path that deploys).
# Requires SOURCE_MODE=table — the sidecar ignores it (with a warning) in
# memory mode, so the memory primary/shadow images keep it false.
ARG ADVANCE_DRIVE=false

# All ENV defaults are overridable at `docker run -e` / compose env-block
# time. See go-ivm/REVIEW-final.md for the recommended rollout sequence
# (shadow on 1 prod node → ~1 week observation → flip to primary).
ENV NODE_ENV=production
ENV ZERO_GO_SIDECAR_BINARY_PATH=/opt/go-ivm/go-ivm-sidecar
ENV ZERO_GO_SIDECAR_ENABLED=true
ENV ZERO_GO_SIDECAR_EXTERNALLY_MANAGED=true
ENV ZERO_GO_SIDECAR_SOCKET_PATH=/tmp/go-ivm-shared.sock
ENV ZERO_GO_SIDECAR_SHADOW_MODE=${SHADOW_MODE}
ENV GO_IVM_SOURCE_MODE=${SOURCE_MODE}
ENV ZERO_GO_SIDECAR_GO_PRIMARY_TRIGGER=${GO_PRIMARY_TRIGGER}
ENV ZERO_GO_SIDECAR_LEAN_PRIMARY=${LEAN_PRIMARY}
ENV GO_IVM_ADVANCE_DRIVE=${ADVANCE_DRIVE}
ENV ZERO_GO_SIDECAR_ADVANCE_DRIVE=${ADVANCE_DRIVE}
# --- Production-scale memory/connection guards (2026-06-11 audit) ---
# Replica read+writable pool ceilings. The sidecar's package default (256)
# is sized for ~36 push-mode CGs / ~128 drive-mode CGs (2 pinned snapshotter
# conns per CG); production runs hundreds of CGs per shared sidecar, and
# pool exhaustion surfaces as silent Conn() blocking → TS-side RPC timeouts
# → CG reset storms. 1024 supports ~400 drive-mode CGs with headroom; each
# SQLite conn costs ~2MB page cache (~2GB worst case at full utilization).
# The sidecar logs "replica pool pressure" every 10s when conns start
# queueing — raise this if that line appears.
ENV GO_IVM_MAX_OPEN_CONNS=1024
ENV GO_IVM_MAX_IDLE_CONNS=128
# Soft Go heap ceiling as a percentage of the container's cgroup memory
# limit (GOMEMLIMIT). The sidecar shares the container with the node
# syncer workers, so it must not claim the whole budget. Soft limit: GC
# works harder near the cap instead of the kernel OOM-killing the whole
# container (which takes down every CG plus the node workers). Explicit
# GO_IVM_GOMEMLIMIT / GOMEMLIMIT override the percentage.
ENV GO_IVM_GOMEMLIMIT_PERCENT=40
# Cap on change-log entries advanceToHead[Stream] will materialize for a
# single catch-up diff (entries carry full row values). Above this the RPC
# errors and TS resets/re-hydrates with bounded memory — replaying a diff
# that big is slower than a re-hydrate anyway.
ENV GO_IVM_MAX_DIFF_CHANGES=50000
# Estimated-bytes budget per streamed partial frame. Row-count chunk caps
# alone let 10k fat rows (>6.4KB avg: message bodies, canvas JSON) encode
# past the 64MB wire frame cap — a deterministic hydrate failure loop.
# 8MB leaves ample margin for msgpack overhead under the 64MB cap.
ENV GO_IVM_CHUNK_SOFT_BYTES=8388608
# workers=1 keeps cg state colocated in the single shared sidecar
# (per feedback_shared_sidecar_tuning — bumping workers fragments
# cgs across sidecars under per-worker mode; in shared mode it just
# adds V8 GC overhead with no concurrency win).
ENV ZERO_NUM_SYNC_WORKERS=1
# Litestream paths for the replicator role's continuous backup. When
# ZERO_LITESTREAM_BACKUP_URL is set at deploy time (e.g. an S3/GCS URL),
# zero-cache will use these binaries; when unset, backup is skipped.
ENV ZERO_LITESTREAM_EXECUTABLE=/usr/local/bin/litestream
ENV ZERO_LITESTREAM_EXECUTABLE_V5=/usr/local/bin/litestream-v5
ENV ZERO_LITESTREAM_CONFIG_PATH=/etc/litestream.yml
# Pre-wire OTel auto-instrumentation. The /register hook initializes
# the SDK at startup; OTLP exporter no-ops when
# OTEL_EXPORTER_OTLP_ENDPOINT is unset, so there's no cost for
# operators who don't enable tracing. Set
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318 + OTEL_SERVICE_NAME
# at deploy time to turn it on.
ENV NODE_OPTIONS='--require @opentelemetry/auto-instrumentations-node/register'

EXPOSE 4848

WORKDIR /app/packages/zero-cache

# Custom entrypoint spawns the shared sidecar before zero-cache,
# waits for the socket, then execs the normal zero-cache main.
COPY packages/zero-cache/docker-entrypoint-go-primary.sh /usr/local/bin/zero-cache-entrypoint.sh
RUN chmod +x /usr/local/bin/zero-cache-entrypoint.sh

CMD ["/usr/local/bin/zero-cache-entrypoint.sh"]
