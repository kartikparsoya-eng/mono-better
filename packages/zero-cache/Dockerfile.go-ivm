# Dockerfile for zero-cache with the in-process Go IVM engine (NAPI).
# libgoivm.so is pulled from the published go-ivm image (built by the
# go-ivm repo's GitHub Actions workflow on every push). Override
# GO_IVM_IMAGE to pin a specific tag (default: latest).
#
# NAPI-ONLY (removal sweep, protocolRev 10): the socket transport and its
# shared-sidecar binary are gone — each zero-cache syncer worker dlopens
# /opt/go-ivm/libgoivm.so IN-PROCESS via the goivm_napi addon: no socket,
# no per-frame syscalls, per-row Go→JS delivery, pull-based streaming
# hydrate + push-based streaming advance (advanceToHeadStream).

ARG GO_IVM_IMAGE=ghcr.io/kartikparsoya-eng/go-ivm:latest

# Stage 1: grab the prebuilt Go IVM c-shared library
FROM ${GO_IVM_IMAGE} AS go-ivm

# Stage 2: build litestream from rocicorp's fork (replicator role needs it
# for continuous SQLite → S3/GCS backup so future syncers can restore
# the replica without a multi-GB resync from upstream PG).
FROM golang:1.23 AS litestream-builder
WORKDIR /src
RUN git clone --depth 1 --branch zero@v0.0.9 \
    https://github.com/rocicorp/litestream.git /src/litestream
WORKDIR /src/litestream
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg \
    go build \
      -ldflags "-s -w -extldflags '-static'" \
      -tags osusergo,netgo,sqlite_omit_load_extension \
      -o /usr/local/bin/litestream \
      ./cmd/litestream

# Stage 3: pull official litestream v5 binary (for backward compat with
# older replica backups; rocicorp's pattern keeps both around).
FROM litestream/litestream:0.5.11 AS litestream-v5

# Stage 4: zero-cache runtime
FROM node:22-slim

# Every RUN below that pipes through `tail` must fail when the LEFT side
# fails: Debian's /bin/sh (dash) has no pipefail, so a failed
# `pnpm install | tail -5` exited 0 and produced a broken image that only
# died at runtime (napi-review H2). bash is present in node:22-slim.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
    wget ca-certificates python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package manifests first for better layer caching. pnpm (the repo's
# package manager since the upstream 1.7.0 npm->pnpm migration, #5997)
# resolves workspace:* deps, so every workspace package in zero-cache's
# dependency closure needs its REAL package.json present at install time
# (dirs without a package.json are simply not workspace members — no
# stub manifests needed, unlike the old npm flow).
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/zero-cache/package.json packages/zero-cache/
COPY packages/zero-protocol/package.json packages/zero-protocol/
COPY packages/zero-schema/package.json packages/zero-schema/
COPY packages/zero-events/package.json packages/zero-events/
COPY packages/zero-permissions/package.json packages/zero-permissions/
COPY packages/zero-types/package.json packages/zero-types/
COPY packages/shared/package.json packages/shared/
COPY packages/otel/package.json packages/otel/
COPY packages/zql/package.json packages/zql/
COPY packages/zqlite/package.json packages/zqlite/

# pnpm via corepack (bundled with node 22), pinned to the repo's
# packageManager version — same recipe as packages/zero/Dockerfile.
RUN corepack enable && corepack prepare pnpm@11.5.3 --activate

# Install deps for zero-cache + its workspace dependency closure only
# (the `...` filter suffix includes workspace dependencies). Native
# builds (esbuild, msgpackr-extract, @rocicorp/zero-sqlite3, …) run per
# the allowBuilds list in pnpm-workspace.yaml. devDependencies are
# included deliberately — the container runs `npx tsx`, and tsx is a
# zero-cache devDependency. --frozen-lockfile: the image must install
# EXACTLY what pnpm-lock.yaml pins — a stale lockfile fails the build
# loudly instead of silently resolving fresh versions (H2).
RUN pnpm install --filter zero-cache... --frozen-lockfile 2>&1 | tail -5

# OpenTelemetry auto-instrumentation. Packages are installed at the
# workspace root so they're resolvable from zero-cache at runtime.
# Always installed; SDK is wired via NODE_OPTIONS below but no-ops
# at runtime when OTEL_EXPORTER_OTLP_ENDPOINT is unset (no perf cost
# for operators who don't enable tracing). pnpm has no --no-save;
# `add -w` mutates the root manifest+lockfile inside the image only.
RUN pnpm add -w \
    @opentelemetry/auto-instrumentations-node \
    @opentelemetry/sdk-node \
    2>&1 | tail -5

# Now copy all source
COPY . .

# libgoivm.so — the c-shared Go engine every syncer worker dlopens.
# Unconditional COPY: napi is the ONLY transport, so a go-ivm image
# without the .so must fail THIS build loudly instead of producing an
# image whose every worker dies at dlopen time.
COPY --from=go-ivm /usr/local/lib/libgoivm.so /opt/go-ivm/libgoivm.so

# Compile the goivm_napi N-API addon (the dlopen bridge). In-tree C
# source + binding.gyp, toolchain (python3/make/g++) installed above, and
# node-gyp resolves headers from this exact node build. Fails the build
# loudly rather than producing an image whose engine load dies
# confusingly at runtime. `rebuild` also discards any stale build/ dir
# that leaked into the docker context from a host checkout (wrong-arch
# .node).
RUN cd packages/zero-cache/src/services/view-syncer/go-sidecar/napi \
    && npx --yes node-gyp rebuild 2>&1 | tail -3 \
    && test -f build/Release/goivm_napi.node

# Bundle litestream for the replicator role's SQLite backup pipeline.
# Both v0 (rocicorp fork) and v5 (official) are kept; zero-cache picks
# the right one based on the backup URL's storage version.
COPY --from=litestream-builder /usr/local/bin/litestream /usr/local/bin/litestream
COPY --from=litestream-v5      /usr/local/bin/litestream /usr/local/bin/litestream-v5
# Litestream config lives in our source — copy it to the canonical path
# zero-cache reads from via ZERO_LITESTREAM_CONFIG_PATH.
RUN cp /app/packages/zero-cache/src/services/litestream/config.yml /etc/litestream.yml

# Streaming granularity levers. A client-VISIBLE progressive-render win
# needs BOTH sides lowered together (proven by go-ivm
# engine_streaming_test.go's TestClientFlushSimulation_BothLeversRequired:
# lowering only one keeps time-to-first-row pinned at full-hydrate time):
#   - CHUNK_SIZE caps each Go->TS streamed partial frame at N RowChanges
#     (the sidecar EMIT side: GO_IVM_CHUNK_SIZE — the ONE production knob,
#     controlling hydrate + advance together; Go code default 100).
#   - CURSOR_PAGE_SIZE gates how many deduped rows the view-syncer buffers
#     before poking the client (the TS CONSUMER side: ZERO_CURSOR_PAGE_SIZE).
# STREAMING IS THE DEFAULT: empty CHUNK_SIZE defers to the Go code default
# (100); CURSOR_PAGE_SIZE defaults 100 to match. The per-facet ARGs remain
# for build-matrix pins; empty = defer to GO_IVM_CHUNK_SIZE.
ARG CHUNK_SIZE=
ARG HYDRATE_CHUNK_SIZE=
ARG ADVANCE_CHUNK_SIZE=
ARG CURSOR_PAGE_SIZE=100
# ONE parallelism knob (GO_IVM_PARALLELISM, Go code default 4): hydrate
# lane count P = N, reader-pool floor K = 2×N. Empty = code default.
# Legacy GO_IVM_HYDRATE_LANES / GO_IVM_HYDRATE_READERS override per facet.
ARG PARALLELISM=

# All ENV defaults are overridable at `docker run -e` / compose env-block
# time.
ENV NODE_ENV=production
ENV ZERO_GO_SIDECAR_ENABLED=true
ENV ZERO_GO_SIDECAR_NAPI_LIB_PATH=/opt/go-ivm/libgoivm.so
# Streaming granularity (variant-scoped via the ARGs above). GO_IVM_CHUNK_SIZE
# is the one production knob; the per-facet vars override it when the build
# matrix pins them (empty env = unset to the Go reader — every GO_IVM_* int
# env is guarded by `v != ""`). Cursor page size gates the view-syncer's
# client-poke cadence.
ENV GO_IVM_CHUNK_SIZE=${CHUNK_SIZE}
ENV GO_IVM_PARALLELISM=${PARALLELISM}
ENV GO_IVM_HYDRATE_CHUNK_SIZE=${HYDRATE_CHUNK_SIZE}
ENV GO_IVM_ADVANCE_CHUNK_SIZE=${ADVANCE_CHUNK_SIZE}
ENV ZERO_CURSOR_PAGE_SIZE=${CURSOR_PAGE_SIZE}
# --- Production-scale memory/connection guards (2026-06-11 audit) ---
# Replica read+writable pool ceilings. The engine's package default (256)
# is sized for ~128 drive-mode CGs (2 pinned snapshotter conns per CG);
# production runs hundreds of CGs, and pool exhaustion surfaces as silent
# Conn() blocking → TS-side RPC timeouts → CG reset storms. 1024 supports
# ~400 CGs with headroom; each SQLite conn costs GO_IVM_CONN_CACHE_KB of
# page cache. The engine logs "replica pool pressure" every 10s when conns
# start queueing — raise this if that line appears. SidecarManager divides
# these ceilings across the ZERO_NUM_SYNC_WORKERS in-process engines.
ENV GO_IVM_MAX_OPEN_CONNS=1024
ENV GO_IVM_MAX_IDLE_CONNS=128
# Per-conn SQLite page cache in KB. This is C-side malloc — OUTSIDE
# GOMEMLIMIT's view — and scales as pools × conns × cache: at 1024 conns
# the SQLite default (~2MB) is up to ~4GB of invisible memory. 1MB/conn
# halves that; hot pages stay in the shared, evictable OS page cache.
ENV GO_IVM_CONN_CACHE_KB=1024
# Soft Go heap ceiling as a percentage of the container's cgroup memory
# limit (GOMEMLIMIT). The in-process engines share the container with the
# node syncer workers, so they must not claim the whole budget. Soft
# limit: GC works harder near the cap instead of the kernel OOM-killing
# the whole container (which takes down every CG plus the node workers).
# Explicit GO_IVM_GOMEMLIMIT / GOMEMLIMIT override the percentage.
ENV GO_IVM_GOMEMLIMIT_PERCENT=40
# Estimated-bytes budget per streamed partial frame. Row-count chunk caps
# alone let 10k fat rows (>6.4KB avg: message bodies, canvas JSON) encode
# past the 64MB wire frame cap — a deterministic hydrate failure loop.
# 8MB leaves ample margin for msgpack overhead under the 64MB cap.
ENV GO_IVM_CHUNK_SOFT_BYTES=8388608
# workers=8: V8 event-loop parallelism for poke/cvr/websocket work that
# stays TS-side. Each worker hosts its own in-process Go engine; the Go
# side's compute parallelism comes from GO_IVM_PARALLELISM lanes within
# each engine. Prod Grafana shows ELU headroom supports ~24 workers; 8 is
# the correctness-gated minimum (sandbox soak: bounded memory, no
# cross-worker contention). Code defaults for upstream.maxConns (20) and
# cvr.maxConns (30) are both >= 8.
ENV ZERO_NUM_SYNC_WORKERS=8
# Litestream paths for the replicator role's continuous backup. When
# ZERO_LITESTREAM_BACKUP_URL is set at deploy time (e.g. an S3/GCS URL),
# zero-cache will use these binaries; when unset, backup is skipped.
ENV ZERO_LITESTREAM_EXECUTABLE=/usr/local/bin/litestream
ENV ZERO_LITESTREAM_EXECUTABLE_V5=/usr/local/bin/litestream-v5
ENV ZERO_LITESTREAM_CONFIG_PATH=/etc/litestream.yml
# Pre-wire OTel auto-instrumentation. The /register hook initializes
# the SDK at startup; OTLP exporter no-ops when
# OTEL_EXPORTER_OTLP_ENDPOINT is unset, so there's no cost for
# operators who don't enable tracing. Set
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318 + OTEL_SERVICE_NAME
# at deploy time to turn it on.
ENV NODE_OPTIONS='--require @opentelemetry/auto-instrumentations-node/register'

EXPOSE 4848

WORKDIR /app/packages/zero-cache

# No entrypoint script: with the socket transport gone there is no shared
# sidecar to spawn/await — each syncer worker dlopens libgoivm.so itself.
CMD ["npx", "tsx", "./src/server/runner/main.ts"]
