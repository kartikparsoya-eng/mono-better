                  "name": "text"
                },
                "op": "=",
                "right": {
                  "type": "literal",
                  "value": "hello"
                }
              },
              "alias": "comments"
            }
          }
        ]
      },
      "covering": {
        "table": "issues",
        "orderBy": [
          [
            "id",
            "asc"
