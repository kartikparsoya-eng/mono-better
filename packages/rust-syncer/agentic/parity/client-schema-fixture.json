  "cases": [
    {
      "name": "nothing synced → Internal",
      "tableSpecs": "empty",
      "fullTables": "empty",
      "clientSchema": {
        "tables": {
          "users": {
            "columns": {
              "id": {
                "type": "string"
              }
            },
            "primaryKey": [
              "id"
            ]
          }
        }
      },
      "shard": {
        "appID": "zero",
        "shardNum": 0
      },
      "expected": {
        "kind": "Internal",
        "message": "No tables have been synced from upstream. Please check that the ZERO_UPSTREAM_DB has been properly set."
      }
    },
    {
      "name": "valid",
      "tableSpecs": "withDotted",
      "fullTables": "all",
      "clientSchema": {
        "tables": {
          "users": {
            "columns": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "primaryKey": [
              "id"
            ]
          }
        }
      },
      "shard": {
        "appID": "zero",
        "shardNum": 0
      },
      "expected": null
    },
